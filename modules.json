        "responsibility": "Provide a vendor-neutral OpenTelemetry runtime, OTLP exporters, propagation, sampling, bounded instrumentation, and explicit provider lifecycle for Go services.",
        "non_goals": [
          "Provide vendor-specific ingestion or proprietary telemetry SDK integrations.",
          "Replace standard OpenTelemetry API types or hide provider ownership.",
          "Read runtime configuration implicitly or initialize telemetry through package side effects.",
          "Promise a stable OpenTelemetry log-signal API before its upstream contract is stable."
        ],
        "public_package_identifier": "telemetry",
        "primary_entry_packages": [
          "github.com/faustbrian/go-telemetry/v2"
        ],
        "package_selection": {
          "github.com/faustbrian/go-telemetry/v2": "Use for explicit configuration and lifecycle ownership of trace and metric providers, propagation, exporters, and optional OpenTelemetry globals.",
          "github.com/faustbrian/go-telemetry/v2/adapters/service": "Use to adapt telemetry runtime initialization and shutdown to the Golib service lifecycle.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/cache": "Use to add bounded, payload-free observations around cache operations.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/gocache": "Use to add bounded, payload-free observations around cache operations.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/gohttpclient": "Use for the HTTP-client RoundTripper instrumentation seam while preserving caller-owned transport behavior.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/gopostgres": "Use for bounded pgx query and pool instrumentation without recording SQL or arguments.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/goqueue": "Use to instrument queue handling without retaining messages or raw handler errors.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/goruntime": "Use to register bounded Go runtime metrics on a caller-provided meter provider.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/httpclient": "Use for the HTTP-client RoundTripper instrumentation seam while preserving caller-owned transport behavior.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/nethttp": "Use for private-by-default net/http server and client instrumentation.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/postgres": "Use for bounded pgx query and pool instrumentation without recording SQL or arguments.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/queue": "Use to instrument queue handling without retaining messages or raw handler errors.",
          "github.com/faustbrian/go-telemetry/v2/instrumentation/runtime": "Use to register bounded Go runtime metrics on a caller-provided meter provider.",
          "github.com/faustbrian/go-telemetry/v2/metric": "Use for metric views, histogram boundaries, attribute allow-lists, and cardinality limits.",
          "github.com/faustbrian/go-telemetry/v2/otlp": "Use to construct explicit OTLP gRPC or HTTP/protobuf trace and metric exporters.",
          "github.com/faustbrian/go-telemetry/v2/propagation": "Use for bounded W3C trace-context and trusted-baggage propagation policies.",
          "github.com/faustbrian/go-telemetry/v2/telemetryservice": "Use to adapt telemetry runtime initialization and shutdown to the Golib service lifecycle.",
          "github.com/faustbrian/go-telemetry/v2/testtelemetry": "Use in tests for deterministic in-memory providers and telemetry snapshots.",
          "github.com/faustbrian/go-telemetry/v2/trace": "Use for always-on, always-off, ratio, and parent-based trace sampling policies."
        },
